		{
			"name": "GET Reference",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"let response = pm.response.json();\r",
							"\r",
							"// Test Case 1 - Validate Response Status Code is 200\r",
							"pm.test(\"Validate status code is 200\", () => {\r",
							"  pm.expect(pm.response.code).to.eql(200);\r",
							"});\r",
							"\r",
							"// Test Case 2 - Validate Response Time  \r",
							"pm.test(\"Validate response time is under provided threshold\", function() {\r",
							"    const responseTimeThreshold = Number(pm.environment.get(\"responseTimeThreshold\"));\r",
							"    pm.expect(pm.response.responseTime, \"Response time was longer than \" + responseTimeThreshold + \" ms.\").to.be.below(responseTimeThreshold);\r",
							"});\r",
							"\r",
							"// Test Case 3 - Schema Validation\r",
							"pm.test(\"Validate schema\", function () {\r",
							"    const referenceDataTypes = [\"ChargerTypes\", \"StatusTypes\", \"ConnectionTypes\", \"CurrentTypes\", \"Countries\", \"DataProviders\"]; \r",
							"    referenceDataTypes.forEach((arrayName) => {\r",
							"        // Check array exists\r",
							"        pm.expect(response, `Missing '${arrayName}' array`).to.have.property(arrayName);\r",
							"        const items = response[arrayName];\r",
							"\r",
							"        // Check it's an array\r",
							"        pm.expect(Array.isArray(items), `'${arrayName}' should be an array`).to.be.true;\r",
							"\r",
							"        // Validate each item in the array\r",
							"        items.forEach((item, index) => {\r",
							"            pm.expect(item, `Missing 'ID' in ${arrayName}[${index}]`).to.have.property(\"ID\");\r",
							"            pm.expect(item, `Missing 'Title' in ${arrayName}[${index}]`).to.have.property(\"Title\");\r",
							"        });\r",
							"    });\r",
							"});\r",
							"\r",
							"// Test Case 4 - ChargerType Array \r",
							"pm.test(\"Validate chargerTypes contains both Fast and Slow chargers\", function () {\r",
							"    // Ensure ChargerTypes exists and is an array\r",
							"    pm.expect(response).to.have.property(\"ChargerTypes\");\r",
							"    let chargerTypes = response.ChargerTypes;\r",
							"    pm.expect(Array.isArray(chargerTypes), \"ChargerTypes should be an array\").to.be.true;\r",
							"\r",
							"    // Flags to track presence\r",
							"    let hasFastCharger = false;\r",
							"    let hasSlowCharger = false;\r",
							"\r",
							"    // Scan each charger type\r",
							"    chargerTypes.forEach((type, index) => {\r",
							"        if (type.IsFastChargeCapable === true) {\r",
							"            hasFastCharger = true;\r",
							"        }\r",
							"        if (type.IsFastChargeCapable === false) {\r",
							"            hasSlowCharger = true;\r",
							"        }\r",
							"    });\r",
							"\r",
							"    // Final assertions\r",
							"    pm.expect(hasFastCharger, \"No Fast charger type found (IsFastChargeCapable: true)\").to.be.true;\r",
							"    pm.expect(hasSlowCharger, \"No Slow charger type found (IsFastChargeCapable: false)\").to.be.true;\r",
							"});\r",
							"\r",
							"// Test Case 5 - Assert that there are no duplicate IDs in StatusTypes\r",
							"pm.test(\"Validate statusTypes should have unique IDs\", function () {\r",
							"    let statusTypes = response.StatusTypes;\r",
							"\r",
							"    // Create a Set to store unique IDs\r",
							"    let idSet = new Set();\r",
							"\r",
							"    // Flag to track duplicates\r",
							"    let hasDuplicate = false;\r",
							"\r",
							"    // Loop through each item and check for duplicates\r",
							"    statusTypes.some(item => {\r",
							"        if (idSet.has(item.ID)) {\r",
							"            hasDuplicate = true;\r",
							"            return true; // stops iteration when duplicate found\r",
							"        } else {\r",
							"            idSet.add(item.ID);\r",
							"            return false;\r",
							"        }\r",
							"    });\r",
							"\r",
							"    // Final assertion to check duplicates\r",
							"    pm.expect(hasDuplicate).to.be.false;\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
