	"item": [
		{
			"name": "GET POI",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"\r",
							"// Test Case 1 - Validate Response Status Code is 200\r",
							"pm.test(\"Validate status code is 200\", () => {\r",
							"  pm.expect(pm.response.code).to.eql(200);\r",
							"});\r",
							"\r",
							"// Test Case 2 - Validate Response Time  \r",
							"pm.test(\"Validate response time is under provided threshold\", function() {\r",
							"    const responseTimeThreshold = Number(pm.environment.get(\"responseTimeThreshold\"));\r",
							"    pm.expect(pm.response.responseTime, \"Response time was longer than \" + responseTimeThreshold + \" ms.\").to.be.below(responseTimeThreshold);\r",
							"});\r",
							"\r",
							"// Test Case 3 - Validate Response Schema\r",
							"pm.test(\"Validate Response Schema\", function () {\r",
							"    pm.expect(Array.isArray(response)).to.be.true;\r",
							"    response.forEach((poi, index) => {\r",
							"        pm.expect(poi,`Missing 'ID' in POI at index ${index}`).to.have.property(\"ID\");\r",
							"        pm.expect(poi, `Missing 'AddressInfo' in POI at index ${index}`).to.have.property(\"AddressInfo\");\r",
							"        pm.expect(poi.AddressInfo, `Missing 'Latitude' in AddressInfo at index ${index}`).to.have.property(\"Latitude\");\r",
							"        pm.expect(poi.AddressInfo, `Missing 'Longitude' in AddressInfo at index ${index}`).to.have.property(\"Longitude\");\r",
							"        pm.expect(poi, `Missing 'NumberOfPoints' in POI at index ${index}`).to.have.property(\"NumberOfPoints\");\r",
							"    });\r",
							"});\r",
							"\r",
							"// Test Case 4 - Validate POI Result Count\r",
							"pm.test(\"Validate POI result count\", function () {\r",
							"    pm.expect(response.length, \"Expected exactly 5 results\").to.equal(5);\r",
							"});\r",
							"\r",
							"// Test Case 5 - Validate POIs are with in 10km range\r",
							"pm.test(\"Validate all POIs are within 10km of target coordinates\", function () {\r",
							"    response.forEach((poi, index) => {\r",
							"        const distance = poi.AddressInfo.Distance;\r",
							"        pm.expect(distance, `POI at index ${index} is ${distance} km away`).to.be.below(10);\r",
							"    });\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
